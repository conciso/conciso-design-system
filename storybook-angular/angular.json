{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "conciso-ds-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cds",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/conciso-ds-angular",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [],
            "styles": [],
            "scripts": []
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "conciso-ds-angular:build",
            "tsConfig": ".storybook/tsconfig.json",
            "port": 6006,
            "host": "0.0.0.0",
            "open": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "conciso-ds-angular:build",
            "tsConfig": ".storybook/tsconfig.json",
            "outputDir": "storybook-static"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              ".storybook/**/*.ts"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
