{
  "name": "@conciso/design-system-storybook-angular",
  "version": "0.1.0",
  "description": "Angular-Komponenten + Storybook für das Conciso Design System. Dokumentiert die portable CSS-Schicht (../css, ../dist) und stellt Komponenten bereit",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "storybook": "ng run conciso-ds-angular:storybook",
    "build-storybook": "ng run conciso-ds-angular:build-storybook",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test-storybook": "PLAYWRIGHT_BROWSERS_PATH=0 test-storybook --url http://localhost:6006"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/angular": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.4.6",
    "typescript": "~5.8.0"
  }
}
