.DS_Store
node_modules/
*.log

# Build-Artefakte (dist/, tokens/) werden bewusst eingecheckt, damit das Paket
# direkt aus dem Repo nutzbar ist; `npm run build` regeneriert sie aus den CSS-Quellen.

# design-sync Arbeitsverzeichnisse (nicht committen)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.idea/

# PR-Vorschau-Build
/_preview/

# Lokaler Issue-Tracker der Agenten-Skills: Arbeitsstand, bewusst NICHT versioniert
# (siehe docs/agents/issue-tracker.md)
.scratch/

# Angular-Build-Cache (wird bei jedem Build neu erzeugt)
.angular/

# Lokale Kopien der Root-LICENSE/NOTICE fuer die Angular-Lib: ng-packagr laesst in
# ng-package.json#assets keine Pfade ausserhalb des Projekt-Roots
# (angular-lib/projects/design-system-angular/) zu, deshalb kopiert das build-Script in
# angular-lib/package.json sie dorthin, statt sie einzuchecken (siehe dort).
angular-lib/projects/design-system-angular/LICENSE
angular-lib/projects/design-system-angular/NOTICE

# Worktrees der Claude-Code-Agenten (kurzlebig, nie Teil des Repos)
.claude/worktrees/

# MCP-Server (ADR-0012): Snapshot aus dem Storybook-Build (npm run build:snapshot) und die
# LICENSE-Kopie aus der Root (npm run prepack, dasselbe Muster wie bei der Angular-Lib) sind
# abgeleitet und werden nie committet.
mcp-server/snapshot/
mcp-server/LICENSE

# Ausgabe des semantic-release-Dry-Runs (siehe release.config.mjs, ADR-0010) — Version und
# Notes werden im Publish-Workflow nach $GITHUB_OUTPUT bzw. per Artefakt weitergereicht,
# nie committet.
/release-version.txt
/release-notes-generated.md

# Aus dem ehemaligen angular-lib/.gitignore übernommen (angular-lib/dist/ mit Präfix,
# weil das Wurzel-dist/ oben bewusst eingecheckt ist — ein bloßes „dist/“ würde das
# mittreffen). /tmp, out-tsc/ und coverage/ sind Angular-CLI-/Test-Build-Artefakte, die
# in jedem Workspace entstehen können.
angular-lib/dist/
/tmp
out-tsc/
coverage/

# Visual Studio Code: nur die eingecheckten Dateien ausnehmen (Muster wie im ehemaligen
# angular-lib/.gitignore).
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
