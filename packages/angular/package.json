{
  "name": "@conciso/design-system-angular",
  "version": "0.0.0",
  "description": "Angular-Wrapper-Komponenten für das Conciso Design System — dünne Hüllen über der framework-agnostischen CSS-Schicht (@conciso/design-system). Liefert kein eigenes CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conciso/conciso-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "ng": "ng",
    "build": "node -e \"const fs=require('fs');for(const f of ['LICENSE','NOTICE'])fs.copyFileSync('../../'+f,f)\" && ng build design-system-angular",
    "watch": "ng build design-system-angular --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@conciso/design-system": "0.0.x",
    "@lucide/angular": "^1.54.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@lucide/angular": "1.54.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.6.0",
    "ng-packagr": "^22.1.1",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "sideEffects": false
}
